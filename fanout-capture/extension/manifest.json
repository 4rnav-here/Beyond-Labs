{
  "manifest_version": 3,
  "name": "Fan-out Capture",
  "version": "0.1.0",
  "description": "Shows the hidden search queries, retrieved sources and citation snapshots behind AI assistant answers. Everything stays in your browser.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*", "https://chat.openai.com/*", "https://www.perplexity.ai/*",
    "https://gemini.google.com/*", "https://claude.ai/*", "https://grok.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Fan-out Capture" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://grok.com/*"],
      "js": ["inject.js"], "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://www.perplexity.ai/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://grok.com/*"],
      "js": ["bridge.js"], "run_at": "document_start"
    }
  ]
}
